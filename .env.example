# Copy to .env.local and fill in real values. .env.local is gitignored.

# --- Peoplelytics search-console-setup (GSC / Bing / IndexNow) ---
# Canonical site URL, no trailing slash.
SITE_URL=https://piedmontdentalbydesign.com

# Self-generated — do NOT reuse across sites. Generate with:
#   node scripts/generate-indexnow-key.mjs
# That writes public/<key>.txt (the ownership-proof file IndexNow requires)
# — commit that file alongside the matching key below.
INDEXNOW_KEY=

# Shared secret checked by app/api/revalidate/route.ts. Self-generated, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Google Search Console ownership verification (HTML tag method). Get this
# from GSC > Settings > Ownership verification > HTML tag > the `content`
# attribute value (NOT the whole <meta> tag). Requires a human with dashboard
# access — see project README / launch notes for the manual GSC steps.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership verification (Meta tag method). Get this
# from BWT > Settings > Verification options > the `content` attribute value
# of the msvalidate.01 meta tag. Requires a human with dashboard access.
BING_SITE_VERIFICATION=

# Optional — only needed to use scripts/bwt-submit-urls.mjs (direct Bing
# Webmaster API submission / quota checks). From BWT > Settings (gear) >
# API access > Generate.
BWT_API_KEY=
